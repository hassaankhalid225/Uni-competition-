{
  "name": "campus-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/lib/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/lib/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:setup:http": "tsx --env-file-if-exists=.env.local src/lib/db/setup-http.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "jose": "^6.2.18",
    "lenis": "^1.3.28",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
