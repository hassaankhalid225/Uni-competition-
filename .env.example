# Postgres connection string. On Vercel use the pooled URL from Storage → Neon.
DATABASE_URL="postgres://postgres@localhost:5432/campus_connect"
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`). Signs session cookies.
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
